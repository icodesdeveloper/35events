generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminAllowlist {
  id        String   @id @default(cuid())
  email     String   @unique
  label     String?
  createdAt DateTime @default(now())
}

model Participant {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  disabledAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  magicLinkTokens ParticipantMagicLinkToken[]
  registrations   Registration[]
  discountCodes   DiscountCode[]
}

model ParticipantMagicLinkToken {
  id            String    @id @default(cuid())
  participantId String
  tokenHash     String    @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

model Event {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  description      String
  date             DateTime
  endDate          DateTime?
  distanceKm       Float?
  durationMinutes  Int?
  price            Decimal?
  passengerPrice   Decimal?
  maxPassengers    Int       @default(0)
  coverImagePath   String?
  published        Boolean   @default(false)
  registrationOpen Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  media         EventMedia[]
  registrations Registration[]
  questionForm  EventQuestionForm?
  discountCodes DiscountCode[]

  @@index([date])
}

// One optional extra-info form per event — created lazily by the admin UI,
// editable freely while draft; publishing notifies current registrants (see
// lib/notifications/extraInfo.ts).
model EventQuestionForm {
  id            String    @id @default(cuid())
  eventId       String    @unique
  published     Boolean   @default(false)
  publishedAt   DateTime?
  deadline      DateTime?
  // Manual admin override, independent of the deadline — lets the admin
  // close submissions early or reopen them without touching the deadline.
  responsesOpen Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  questions EventQuestion[]
}

model EventQuestion {
  id           String  @id @default(cuid())
  formId       String
  type         String // QuestionType: TEXT | EMAIL | NUMBER | SELECT — see lib/validation/question.ts
  label        String
  required     Boolean @default(false)
  perPassenger Boolean @default(false) // asked once per person (driver + each passenger) instead of once per registration
  options      Json? // string[] — only used for SELECT
  order        Int     @default(0)

  form    EventQuestionForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers EventQuestionAnswer[]

  @@index([formId, order])
}

model EventQuestionAnswer {
  id             String   @id @default(cuid())
  questionId     String
  registrationId String
  // 0 = the registrant/driver, 1..N = the Nth passenger — always 0 for
  // questions that aren't perPassenger. See lib/questionForms.ts.
  passengerIndex Int      @default(0)
  value          String
  updatedAt      DateTime @updatedAt

  question     EventQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  registration Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([questionId, registrationId, passengerIndex])
}

model EventMedia {
  id        String   @id @default(cuid())
  eventId   String
  type      String // EventMediaType: PHOTO | VIDEO
  filePath  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, order])
}

model Registration {
  id                      String    @id @default(cuid())
  eventId                 String
  participantId           String
  vehicleMake             String
  vehicleModel            String
  vehicleType             String?
  vehiclePhotoPath        String
  passengerCount          Int       @default(0)
  priceSnapshot           Decimal?
  passengerPriceSnapshot  Decimal?
  discountCodeId          String?
  discountAmountSnapshot  Decimal?
  paymentStatus           String    @default("PENDING_PAYMENT") // PaymentStatus: PENDING_PAYMENT | CONFIRMED | CANCELLED — see lib/payments.ts
  // Short code the participant puts in the bank transfer description so an
  // incoming payment can be matched back to this registration — see
  // lib/payments.ts and app/admin/(dashboard)/payments/actions.ts.
  paymentReference        String?   @unique
  // Set when the extra-info "please fill this in" mail goes out (on publish)
  // and cleared/reset on every republish so a new reminder cycle can run
  // against the new deadline.
  extraInfoNotifiedAt     DateTime?
  extraInfoReminderSentAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant  Participant           @relation(fields: [participantId], references: [id], onDelete: Cascade)
  discountCode DiscountCode?         @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  answers      EventQuestionAnswer[]
  payments     Payment[]

  @@unique([eventId, participantId])
  @@index([eventId])
  @@index([participantId])
  @@index([discountCodeId])
}

// Percentage or fixed-amount discount, redeemed by the participant at
// registration time (see app/(public)/events/[slug]/register/actions.ts and
// lib/discounts.ts). Optionally scoped to one event and/or one participant,
// a validity window, and a use-count cap.
model DiscountCode {
  id            String    @id @default(cuid())
  code          String    @unique
  type          String // DiscountType: PERCENT | FIXED — see lib/discounts.ts
  value         Decimal
  eventId       String?
  participantId String?
  validFrom     DateTime?
  validUntil    DateTime?
  maxUses       Int?
  useCount      Int       @default(0)
  createdAt     DateTime  @default(now())

  event         Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant   Participant?   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@index([eventId])
  @@index([participantId])
}

// One row per bank transfer matched to a registration via paymentReference —
// not a single "amount received" field, since a participant may pay in
// installments or send too much/too little (see lib/payments.ts).
model Payment {
  id             String   @id @default(cuid())
  registrationId String
  amount         Decimal
  receivedAt     DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}

// A mass mail to participants — see lib/campaigns.ts for audience resolution
// and app/admin/(dashboard)/communications/actions.ts for the send/schedule
// flow. Audience is stored as a filter (not a frozen recipient list) and
// re-resolved at preview and send time.
model Campaign {
  id           String    @id @default(cuid())
  subject      String
  bodyHtml     String
  status       String    @default("DRAFT") // CampaignStatus: DRAFT | SCHEDULED | SENT — see lib/campaigns.ts
  audienceMode String // AudienceMode: ALL_PARTICIPANTS | EVENTS — see lib/campaigns.ts
  eventIds     Json? // string[] — only used when audienceMode = EVENTS
  statuses     Json? // string[] subset of PaymentStatus — only used when audienceMode = EVENTS
  scheduledAt  DateTime?
  sentAt       DateTime?
  sentCount    Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

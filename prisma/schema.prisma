generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Singleton row (fixed id) for site-wide admin-configurable settings —
// currently just the bank account shown in payment instructions. See
// lib/settings.ts.
model Settings {
  id              String  @id @default("singleton")
  bankAccountIban String?
  bankAccountName String?
  // Shown in the public header, admin sidebar, and email header (see
  // lib/mail/layout.ts) in place of the plain "35" mark once set.
  logoPath        String?
}

model AdminAllowlist {
  id        String   @id @default(cuid())
  email     String   @unique
  label     String?
  createdAt DateTime @default(now())
}

model Participant {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  disabledAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  magicLinkTokens ParticipantMagicLinkToken[]
  registrations   Registration[]
  discountCodes   DiscountCode[]
}

model ParticipantMagicLinkToken {
  id            String    @id @default(cuid())
  participantId String
  tokenHash     String    @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

// Mail that could not be handed to the SMTP server. Every send in the app
// goes through lib/mail/transporter.ts, so a failure anywhere — registration
// confirmation, login link, campaign — lands here instead of vanishing into
// a swallowed catch. lib/notifications/outbox.ts retries the queue hourly,
// and because the rows live in the database the backlog survives a restart.
model OutboundMail {
  id      String @id @default(cuid())
  to      String
  subject String
  text    String
  html    String
  // Free-form label telling the admin where a stuck mail came from, e.g.
  // "registratiebevestiging" or "communicatie".
  source  String?

  status        String    @default("PENDING") // PENDING | SENT
  attempts      Int       @default(0)
  lastError     String?
  lastAttemptAt DateTime?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, createdAt])
}

model Event {
  id                    String    @id @default(cuid())
  slug                  String    @unique
  name                  String
  description           String
  date                  DateTime
  endDate               DateTime?
  distanceKm            Float?
  durationMinutes       Int?
  price                 Decimal?
  passengerPrice        Decimal?
  maxPassengers         Int       @default(0)
  // Prefix for this event's payment references, e.g. "TR26-" giving TR26-A43,
  // TR26-B49, ... Filled with a suggestion derived from the name and year
  // when the admin leaves it blank (see lib/paymentReference.ts). Null only
  // for events created before this existed; those keep their old random
  // codes and get a prefix the next time they are saved.
  paymentReferencePrefix String?
  coverImagePath        String?
  published             Boolean   @default(false)
  registrationOpen      Boolean   @default(false)
  registrationStartDate DateTime?
  registrationEndDate   DateTime?
  // Pending, unpublished snapshot of the core content fields (everything in
  // components/forms/EventFormFields.tsx, plus the two registration-window
  // dates above) — only used once the event has been published at least
  // once. See app/admin/(dashboard)/events/[id]/edit/actions.ts.
  draftData             Json?
  // Admin-controlled media visibility — replaces the old "past events just
  // automatically show under /media" behavior (see lib/events.ts history).
  // mediaVisibility: MediaVisibility (PUBLIC | PARTICIPANTS_ONLY | HIDDEN) —
  // the default that EventMediaSection rows inherit. mediaVisibleFromDate/
  // mediaVisibleFromTarget are an optional one-time scheduled nudge (same
  // edge-triggered, non-overlapping semantics as registrationStartDate/
  // registrationEndDate — see lib/notifications/registrationWindow.ts and
  // its media counterpart lib/notifications/mediaVisibility.ts): once that
  // date has passed, mediaVisibility flips from HIDDEN to the chosen target
  // exactly once, and never fights a manual change afterward.
  mediaVisibility        String    @default("HIDDEN")
  mediaVisibleFromDate   DateTime?
  mediaVisibleFromTarget String?
  // DownloadPermission (EVERYONE | PARTICIPANTS_ONLY | NOBODY) — default
  // that EventMediaSection rows inherit. Always bounded by visibility: see
  // lib/media.ts.
  downloadPermission     String    @default("NOBODY")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  media           EventMedia[]
  mediaSections   EventMediaSection[]
  mediaShareLinks EventMediaShareLink[]
  registrations   Registration[]
  questionForm    EventQuestionForm?
  discountCodes   DiscountCode[]
  earlybirdPrices EarlybirdPrice[]

  @@index([date])
}

// A shareable capability URL that grants participant-level access to one
// event's media without an account — for sending round in WhatsApp to people
// who registered but never signed up. It lifts a viewer to exactly what a
// registered participant sees: PARTICIPANTS_ONLY sections become visible,
// HIDDEN ones deliberately stay hidden, and downloads follow the same rule.
//
// The token is stored in plaintext on purpose (unlike ParticipantMagicLinkToken,
// which is hashed): the admin has to be able to re-copy the same link later,
// and this grants only media viewing, never account access. Revoke instead of
// rotating if a link escapes.
model EventMediaShareLink {
  id         String    @id @default(cuid())
  eventId    String
  token      String    @unique
  label      String?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// A named, independently-visible group of EventMedia within an event (e.g.
// "Aftermovie", "Sfeerfoto's") — see lib/media.ts for how effective
// visibility/download rights are resolved and app/admin/(dashboard)/events/
// [id]/media for how they're managed.
model EventMediaSection {
  id          String  @id @default(cuid())
  eventId     String
  title       String
  order       Int     @default(0)
  isHighlight Boolean @default(false)

  // Public gallery only: render this section collapsed so a visitor has to
  // open it themselves. Purely presentational — it does not hide anything
  // that visibility/download rights would otherwise allow. The admin list is
  // always collapsed on load regardless, which is local UI state, not this.
  collapsedByDefault Boolean @default(false)

  // Visibility and download rights are two fully independent dimensions —
  // each with its own inherit-from-event switch, deliberately not bundled
  // into one "override" toggle (a section may be visible to participants
  // while still downloadable by nobody).
  inheritVisibility  Boolean   @default(true)
  visibility         String    @default("HIDDEN")
  visibleFromDate    DateTime?
  visibleFromTarget  String?
  inheritDownload    Boolean   @default(true)
  downloadPermission String    @default("NOBODY")

  createdAt DateTime @default(now())

  event Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media EventMedia[]

  @@index([eventId, order])
}

// A price tier that applies while its deadline hasn't passed yet — see
// lib/pricing.ts for how the effective price is resolved (earliest
// still-valid deadline wins; falls back to Event.price once all have
// passed, or if there are none).
model EarlybirdPrice {
  id        String   @id @default(cuid())
  eventId   String
  deadline  DateTime
  price     Decimal
  // Optional earlybird rate per passenger. Null means "no separate earlybird
  // for passengers", and the event's regular passengerPrice applies for the
  // whole tier — so leaving this empty keeps the pre-existing behaviour where
  // only the driver got the discount. See lib/pricing.ts.
  passengerPrice Decimal?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// One optional extra-info form per event — created lazily by the admin UI,
// editable freely while draft; publishing notifies current registrants (see
// lib/notifications/extraInfo.ts).
model EventQuestionForm {
  id            String    @id @default(cuid())
  eventId       String    @unique
  published     Boolean   @default(false)
  publishedAt   DateTime?
  deadline      DateTime?
  // Manual admin override, independent of the deadline — lets the admin
  // close submissions early or reopen them without touching the deadline.
  responsesOpen Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  questions EventQuestion[]
}

model EventQuestion {
  id           String  @id @default(cuid())
  formId       String
  type         String // QuestionType: TEXT | EMAIL | NUMBER | SELECT — see lib/validation/question.ts
  label        String
  required     Boolean @default(false)
  perPassenger Boolean @default(false) // asked once per person (driver + each passenger) instead of once per registration
  options      Json? // string[] — only used for SELECT
  order        Int     @default(0)

  form    EventQuestionForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers EventQuestionAnswer[]

  @@index([formId, order])
}

model EventQuestionAnswer {
  id             String   @id @default(cuid())
  questionId     String
  registrationId String
  // 0 = the registrant/driver, 1..N = the Nth passenger — always 0 for
  // questions that aren't perPassenger. See lib/questionForms.ts.
  passengerIndex Int      @default(0)
  value          String
  updatedAt      DateTime @updatedAt

  question     EventQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  registration Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([questionId, registrationId, passengerIndex])
}

model EventMedia {
  id        String   @id @default(cuid())
  eventId   String
  sectionId String
  type      String // EventMediaType: PHOTO | VIDEO
  filePath  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  // Downscaled WebP still-image derivatives of filePath, generated at upload
  // time. Grids render thumbPath and the lightbox renders previewPath, so a
  // gallery of hundreds of 10MB photos doesn't ship the originals — those are
  // served only on an explicit download. For a PHOTO these come from
  // lib/storage/deriveImages.ts; for a VIDEO they're poster frames grabbed by
  // lib/storage/deriveVideo.ts, which is what lets a video tile show a still
  // instead of streaming the file. Null for rows predating this and for files
  // ffmpeg/sharp couldn't decode; every consumer falls back to filePath.
  thumbPath   String?
  previewPath String?

  // VIDEO only: web-optimized 1080p H.264 transcode used for playback, so
  // visitors never stream the multi-gigabyte original. Null while it is still
  // being produced (see processingStatus) or if transcoding failed — players
  // fall back to filePath, which always works, just heavier.
  webPath String?

  // VIDEO only: PROCESSING | READY | FAILED. Transcoding runs in the
  // background after the upload response, so this is what the admin UI reads
  // to show "wordt verwerkt". Null for photos and for legacy rows.
  processingStatus String?

  event   Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  section EventMediaSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([eventId, order])
  @@index([sectionId, order])
}

model Registration {
  id                      String    @id @default(cuid())
  eventId                 String
  participantId           String
  vehicleMake             String
  vehicleModel            String
  vehicleType             String?
  vehiclePhotoPath        String?
  // True for registrations the admin created on someone's behalf (see
  // adminCreateRegistration in the registrations actions) — these never go
  // through the public form, so there's no vehicle photo.
  addedManually           Boolean   @default(false)
  passengerCount          Int       @default(0)
  priceSnapshot           Decimal?
  passengerPriceSnapshot  Decimal?
  discountCodeId          String?
  discountAmountSnapshot  Decimal?
  paymentStatus           String    @default("PENDING_PAYMENT") // PaymentStatus: PENDING_PAYMENT | CONFIRMED | CANCELLED — see lib/payments.ts
  // Short code the participant puts in the bank transfer description so an
  // incoming payment can be matched back to this registration — see
  // lib/payments.ts and app/admin/(dashboard)/payments/actions.ts.
  paymentReference        String?   @unique
  // Set when the extra-info "please fill this in" mail goes out (on publish)
  // and cleared/reset on every republish so a new reminder cycle can run
  // against the new deadline.
  extraInfoNotifiedAt     DateTime?
  extraInfoReminderSentAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant  Participant           @relation(fields: [participantId], references: [id], onDelete: Cascade)
  discountCode DiscountCode?         @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  answers      EventQuestionAnswer[]
  payments     Payment[]

  @@unique([eventId, participantId])
  @@index([eventId])
  @@index([participantId])
  @@index([discountCodeId])
}

// Percentage or fixed-amount discount, redeemed by the participant at
// registration time (see app/(public)/events/[slug]/register/actions.ts and
// lib/discounts.ts). Optionally scoped to one event and/or one participant,
// a validity window, and a use-count cap.
model DiscountCode {
  id            String    @id @default(cuid())
  code          String    @unique
  type          String // DiscountType: PERCENT | FIXED — see lib/discounts.ts
  value         Decimal
  eventId       String?
  participantId String?
  validFrom     DateTime?
  validUntil    DateTime?
  maxUses       Int?
  useCount      Int       @default(0)
  createdAt     DateTime  @default(now())

  event         Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant   Participant?   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@index([eventId])
  @@index([participantId])
}

// One row per bank transfer matched to a registration via paymentReference —
// not a single "amount received" field, since a participant may pay in
// installments or send too much/too little (see lib/payments.ts).
model Payment {
  id             String   @id @default(cuid())
  registrationId String
  amount         Decimal
  receivedAt     DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}

// A mass mail to participants — see lib/campaigns.ts for audience resolution
// and app/admin/(dashboard)/communications/actions.ts for the send/schedule
// flow. Audience is stored as a filter (not a frozen recipient list) and
// re-resolved at preview and send time.
model Campaign {
  id             String    @id @default(cuid())
  subject        String
  bodyHtml       String
  status         String    @default("DRAFT") // CampaignStatus: DRAFT | SCHEDULED | SENT — see lib/campaigns.ts
  audienceMode   String // AudienceMode: ALL_PARTICIPANTS | EVENTS | SPECIFIC_PARTICIPANTS — see lib/campaigns.ts
  eventIds       Json? // string[] — only used when audienceMode = EVENTS
  statuses       Json? // string[] subset of PaymentStatus — only used when audienceMode = EVENTS
  participantIds Json? // string[] — only used when audienceMode = SPECIFIC_PARTICIPANTS
  scheduledAt    DateTime?
  sentAt         DateTime?
  sentCount      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
